<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mail Link – Outlook add-in (new Outlook / Outlook on the web / classic)
  Filene hostes via GitHub Pages fra repoet ivarstange/outlook-util (mappen maillink/).
  Bytter du host: søk/erstatt https://ivarstange.github.io/outlook-util/maillink og AppDomain.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>606ced51-7980-4e57-8d90-407aa2262218</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Mail Link</ProviderName>
  <DefaultLocale>nb-NO</DefaultLocale>
  <DisplayName DefaultValue="Mail Link"/>
  <Description DefaultValue="Hent en direktelenke (deeplink) til den valgte eposten, slik at du kan lime den inn i andre apper."/>
  <IconUrl DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://ivarstange.github.io/outlook-util/maillink/taskpane.html"/>

  <AppDomains>
    <AppDomain>https://ivarstange.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://ivarstange.github.io/outlook-util/maillink/taskpane.html"/>
        <RequestedHeight>300</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="MailLinkGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="MailLinkButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Mail Link"/>
        <bt:String id="Button.Label" DefaultValue="Hent lenke"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tip" DefaultValue="Vis og kopier direktelenken til denne eposten."/>
      </bt:LongStrings>
    </Resources>

    <!-- v1.1: lar sidepanelet festes (pinnes) så det oppdateres når du bytter epost -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="MailLinkGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="MailLinkButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://ivarstange.github.io/outlook-util/maillink/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Mail Link"/>
          <bt:String id="Button.Label" DefaultValue="Hent lenke"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tip" DefaultValue="Vis og kopier direktelenken til denne eposten."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
